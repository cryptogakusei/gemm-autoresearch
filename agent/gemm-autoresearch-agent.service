[Unit]
Description=One isolated autonomous GEMM research iteration
After=network-online.target gemm-autoresearch-controller.service
Wants=network-online.target
Requires=gemm-autoresearch-controller.service
ConditionPathExists=/var/lib/gemm-agent/.local/bin/codex
ConditionPathExists=/var/lib/gemm-agent/.codex/config.toml

[Service]
Type=oneshot
User=gemm-agent
Group=gemm-agent
SupplementaryGroups=gemm-submit
WorkingDirectory=/var/lib/gemm-agent/workspace/gemm-autoresearch
Environment=HOME=/var/lib/gemm-agent
Environment=CODEX_HOME=/var/lib/gemm-agent/.codex
Environment=PATH=/var/lib/gemm-agent/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/libexec/gemm-autoresearch/run_codex_trial.sh
TimeoutStartSec=4h
UMask=0077
TasksMax=256
MemoryMax=8G
LimitNOFILE=1024

NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
DevicePolicy=closed
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Codex's bubblewrap sandbox needs these namespace types. Keep cgroup
# namespaces prohibited by omitting them from the allowlist.
RestrictNamespaces=user mnt pid ipc uts net
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
InaccessiblePaths=/etc/gemm-autoresearch
ReadWritePaths=/var/lib/gemm-agent/.codex
ReadWritePaths=/var/lib/gemm-agent/runs
ReadWritePaths=/var/lib/gemm-agent/workspace/gemm-autoresearch/candidate
ReadOnlyPaths=/var/lib/gemm-agent/.codex/config.toml
